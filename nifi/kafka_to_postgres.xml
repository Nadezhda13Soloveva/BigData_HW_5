<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<template encoding-version="1.3">
    <description>Kafka to PostgreSQL pipeline</description>
    <groupId>root</groupId>
    <name>KafkaToPostgres</name>

    <snippet>

        <processors>

            <!-- Consume Kafka -->
            <processor>
                <id>consume-kafka-id</id>
                <parentGroupId>root</parentGroupId>

                <position>
                    <x>0.0</x>
                    <y>0.0</y>
                </position>

                <name>ConsumeKafka</name>

                <bundle>
                    <group>org.apache.nifi</group>
                    <artifact>nifi-kafka-2-6-nar</artifact>
                    <version>1.25.0</version>
                </bundle>

                <class>org.apache.nifi.processors.kafka.pubsub.ConsumeKafka_2_6</class>

                <maxConcurrentTasks>1</maxConcurrentTasks>
                <schedulingPeriod>0 sec</schedulingPeriod>
                <penaltyDuration>30 sec</penaltyDuration>
                <yieldDuration>1 sec</yieldDuration>
                <bulletinLevel>WARN</bulletinLevel>
                <lossTolerant>false</lossTolerant>

                <scheduledState>STOPPED</scheduledState>
                <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
                <executionNode>ALL</executionNode>

                <config>
                    <properties>

                        <entry>
                            <key>bootstrap.servers</key>
                            <value>kafka:9092</value>
                        </entry>

                        <entry>
                            <key>topic</key>
                            <value>sales_stream</value>
                        </entry>

                        <entry>
                            <key>group.id</key>
                            <value>nifi-sales-group</value>
                        </entry>

                        <entry>
                            <key>auto.offset.reset</key>
                            <value>earliest</value>
                        </entry>

                    </properties>

                    <descriptors/>

                    <autoTerminatedRelationships>
                        <relationship>failure</relationship>
                    </autoTerminatedRelationships>
                </config>
            </processor>

            <!-- PutDatabaseRecord -->
            <processor>
                <id>put-db-record-id</id>
                <parentGroupId>root</parentGroupId>

                <position>
                    <x>400.0</x>
                    <y>0.0</y>
                </position>

                <name>PutDatabaseRecord</name>

                <bundle>
                    <group>org.apache.nifi</group>
                    <artifact>nifi-standard-nar</artifact>
                    <version>1.25.0</version>
                </bundle>

                <class>org.apache.nifi.processors.standard.PutDatabaseRecord</class>

                <maxConcurrentTasks>1</maxConcurrentTasks>
                <schedulingPeriod>0 sec</schedulingPeriod>
                <penaltyDuration>30 sec</penaltyDuration>
                <yieldDuration>1 sec</yieldDuration>
                <bulletinLevel>WARN</bulletinLevel>
                <lossTolerant>false</lossTolerant>

                <scheduledState>STOPPED</scheduledState>
                <schedulingStrategy>TIMER_DRIVEN</schedulingStrategy>
                <executionNode>ALL</executionNode>

                <config>
                    <properties>

                        <entry>
                            <key>Table Name</key>
                            <value>sales_stream</value>
                        </entry>

                        <entry>
                            <key>Translate Field Names</key>
                            <value>true</value>
                        </entry>

                    </properties>

                    <descriptors/>

                    <autoTerminatedRelationships>
                        <relationship>success</relationship>
                        <relationship>failure</relationship>
                    </autoTerminatedRelationships>
                </config>
            </processor>

        </processors>

        <connections>

            <connection>
                <id>connection-id</id>

                <sourceId>consume-kafka-id</sourceId>
                <sourceGroupId>root</sourceGroupId>
                <sourceType>PROCESSOR</sourceType>

                <destinationId>put-db-record-id</destinationId>
                <destinationGroupId>root</destinationGroupId>
                <destinationType>PROCESSOR</destinationType>

                <name>KafkaToPostgres</name>

                <selectedRelationships>
                    <relationship>success</relationship>
                </selectedRelationships>

                <backPressureObjectThreshold>10000</backPressureObjectThreshold>
                <backPressureDataSizeThreshold>1 GB</backPressureDataSizeThreshold>

                <flowFileExpiration>0 sec</flowFileExpiration>
            </connection>

        </connections>

    </snippet>
</template>